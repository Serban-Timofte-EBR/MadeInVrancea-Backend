# ------- Application -------
NODE_ENV=development
PORT=3000

# ------- Authentication (JWT) -------
# Use a long random value in production.
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# ------- Database (SQL Server locally / Azure SQL in production) -------
DB_HOST=localhost
DB_PORT=1433
DB_USERNAME=sa
DB_PASSWORD=Your_password123
DB_NAME=madeinvrancea
# Keep both true for the local Docker SQL Server and for Azure SQL.
DB_ENCRYPT=true
DB_TRUST_SERVER_CERT=true
# Auto-create tables from entities. Keep true for development; set false in
# production and manage schema changes with migrations.
DB_SYNCHRONIZE=true

# ------- Default admin account (seeded on first boot) -------
ADMIN_EMAIL=admin@madeinvrancea.ro
ADMIN_PASSWORD=Admin_password123

# ------- Media storage -------
# Leave AZURE_STORAGE_CONNECTION_STRING empty to store uploads on local disk
# (./uploads). For local Azure emulation with Azurite use:
#   AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
# In production paste the Azure Storage account connection string.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=media
# Optional public base URL (e.g. a CDN) prefixed to returned file URLs.
AZURE_STORAGE_PUBLIC_URL=
